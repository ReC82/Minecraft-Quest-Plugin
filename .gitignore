# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# run-paper test server
run/

# Config locale du portail web-api (jamais de secret dedans : le jeton vient
# uniquement de RPGQUEST_WEB_API_TOKEN, voir docs/WEB_API.md) ; ignorée par
# convention comme tout fichier de config personnalisé non versionné.
web-api/web-api.properties
web-api/products.json
web-api/store.db
web-api/web-export/

# IDE
.idea/
*.iml
*.ipr
*.iws
out/
bin/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# Déploiement VeryGames (issue #10) : le fichier d'identifiants réel vit HORS
# du dépôt (~/.config/rpgquest/verygames.env). Ces règles sont un filet de
# sécurité au cas où quelqu'un le placerait quand même sous scripts/.
# Seul scripts/verygames.env.example (sans secret) est versionné.
scripts/verygames.env
scripts/*.env
!scripts/verygames.env.example
# Backups de JAR téléchargés par les scripts s'ils sont dirigés vers le dépôt.
scripts/verygames-backups/
*.jar.meta

# OS / misc
.DS_Store
*.log
