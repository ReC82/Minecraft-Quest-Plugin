# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# run-paper test server
run/

# Config locale du portail web-api (jamais de secret dedans : le jeton vient
# uniquement de RPGQUEST_WEB_API_TOKEN, voir docs/WEB_API.md) ; ignorée par
# convention comme tout fichier de config personnalisé non versionné.
web-api/web-api.properties
web-api/products.json
web-api/store.db
web-api/web-export/

# IDE
.idea/
*.iml
*.ipr
*.iws
out/
bin/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# OS / misc
.DS_Store
*.log

# RPGQuest Control Panel — configuration et base locales (issue #37)
control-panel.properties
control-panel.db

# PlugAdmin (issue #44) — sécurité : aucun EnvironmentFile réel dans Git.
# Le fichier de prod vit hors dépôt (/etc/plugadmin/plugadmin.env). Ces motifs
# ne couvrent QUE d'éventuelles copies locales ; les .example restent versionnés.
plugadmin.env
scripts/plugadmin/plugadmin.env
scripts/plugadmin/control-panel.properties

# Agent sortant PlugAdmin (issue #51) — le fichier RÉEL vit sur le serveur
# RPGQuest (plugins/RPGQuest/plugadmin-agent.properties) et contient un jeton :
# jamais dans Git. Le .example reste versionné.
plugadmin-agent.properties
scripts/plugadmin-agent.properties

# Python bytecode (scripts/*.py helpers)
__pycache__/
*.pyc
