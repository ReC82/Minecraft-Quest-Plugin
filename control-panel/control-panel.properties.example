# RPGQuest Control Panel — configuration NON SECRÈTE.
# Copier en `control-panel.properties` (répertoire de travail) ou pointer $RPGQUEST_PANEL_CONFIG dessus.
# Les SECRETS ne vont JAMAIS ici : voir les variables d'environnement plus bas.

# --- Serveur local du panel (un reverse proxy TLS public est placé devant — voir docs/control-panel) ---
panel.port=8090
panel.bind=127.0.0.1
panel.base-url=
panel.cookie-secure=true
panel.session-ttl-minutes=120
panel.session-idle-minutes=30
panel.owner-username=owner
panel.disabled=false
panel.db=control-panel.db

# --- Cibles RPGQuest (multi-environnement) ---
targets=dev
targets.default=dev
target.dev.label=RPGQuest DEV
target.dev.mode=bridge
target.dev.bridge-url=http://127.0.0.1:8100/admin/v1
# nom de la variable d'environnement contenant le jeton du bridge pour cette cible
target.dev.token-env=RPGQUEST_BRIDGE_TOKEN_DEV
# agent sortant (#51) associé à cette cible pour l'affichage du dashboard
target.dev.agent=rpgquest-dev

# --- Agents sortants (issue #51) — RPGQuest/VeryGames -> PlugAdmin en HTTPS ---
# Laisser vide (agents=) pour désactiver complètement le canal agent.
agents=rpgquest-dev
agent.rpgquest-dev.environment=dev
agent.rpgquest-dev.token-env=RPGQUEST_AGENT_TOKEN_RPGQUEST_DEV
agent.stale-seconds=45
agent.offline-seconds=150
agent.action-expiry-seconds=300

# ============================================================================
# SECRETS — variables d'environnement uniquement, jamais dans un fichier versionné :
#
#   RPGQUEST_PANEL_SECRET        secret de signature du cookie de session (>= 32 car. aléatoires)
#   RPGQUEST_PANEL_OWNER_HASH    hash du mot de passe owner
#                                -> `java -jar control-panel.jar hash-password`
#   RPGQUEST_BRIDGE_TOKEN_DEV    jeton partagé avec le bridge du plugin (= RPGQUEST_WEB_ADMIN_TOKEN côté plugin)
#   RPGQUEST_AGENT_TOKEN_RPGQUEST_DEV  jeton de l'agent sortant (#51) = clé « token= » de
#                                plugins/RPGQuest/plugadmin-agent.properties côté serveur RPGQuest
#
# Optionnel :
#   RPGQUEST_PANEL_CONFIG        chemin d'un control-panel.properties alternatif
#   RPGQUEST_PANEL_PORT          surcharge de panel.port
#   RPGQUEST_PANEL_COOKIE_SECURE surcharge de panel.cookie-secure (mettre false en http local)
#   PANEL_DISABLED=true          kill-switch (prioritaire sur panel.disabled)
# ============================================================================
