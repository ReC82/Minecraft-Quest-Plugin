      }
    ],
    "dialogues": [
      {
        "id": "rpgquest:tom",
        "start": "accueil",
        "nodes": {
          "accueil": {
            "speaker": "Tom",
            "text": "Ah, un voyageur… J'étais marchand ambulant, jusqu'à ce que des brigands m'attaquent dans la forêt. Mon chariot, mes marchandises : tout est perdu.",
            "choices": [
              { "text": "Je peux t'aider ?",
                "conditions": [ { "type": "QUEST_STATE", "quest": "rpgquest:tom_chariot", "state": "NOT_STARTED" } ],
                "next": "offre_chariot" },
              { "text": "Et maintenant, la bâche ?",
                "conditions": [
                  { "type": "QUEST_STATE", "quest": "rpgquest:tom_chariot", "state": "COMPLETED" },
                  { "type": "QUEST_STATE", "quest": "rpgquest:tom_bache", "state": "NOT_STARTED" } ],
                "next": "offre_bache" },
              { "text": "Il te manque des marchandises ?",
                "conditions": [
                  { "type": "QUEST_STATE", "quest": "rpgquest:tom_bache", "state": "COMPLETED" },
                  { "type": "QUEST_STATE", "quest": "rpgquest:tom_marchandises", "state": "NOT_STARTED" } ],
                "next": "offre_marchandises" },
              { "text": "J'apporte des matériaux",
                "conditions": [ { "type": "HAS_PENDING_DELIVERY" } ],
                "next": "remise" },
              { "text": "Tu repars bientôt ?",
                "conditions": [ { "type": "QUEST_STATE", "quest": "rpgquest:tom_marchandises", "state": "COMPLETED" } ],
                "next": "conclusion" },
              { "text": "Au revoir",
                "actions": [ { "type": "CLOSE" } ] }
            ]
          },
          "offre_chariot": {
            "speaker": "Tom",
            "text": "Pour reconstruire mon chariot, il me faudrait 16 bûches de chêne. Tu me les apporterais ?",
            "choices": [
              { "text": "Commencer la quête : Du bois pour le chariot",
                "conditions": [ { "type": "QUEST_STATE", "quest": "rpgquest:tom_chariot", "state": "NOT_STARTED" } ],
                "actions": [ { "type": "START_QUEST", "quest": "rpgquest:tom_chariot" }, { "type": "CLOSE" } ] },
              { "text": "Pas maintenant",
                "next": "refus" }
            ]
          },
          "offre_bache": {
            "speaker": "Tom",
            "text": "Le chariot tient debout ! Il lui faut une bâche : 6 cuirs suffiront.",
            "choices": [
              { "text": "Commencer la quête : Une bâche de cuir",
                "conditions": [ { "type": "QUEST_STATE", "quest": "rpgquest:tom_bache", "state": "NOT_STARTED" } ],
                "actions": [ { "type": "START_QUEST", "quest": "rpgquest:tom_bache" }, { "type": "CLOSE" } ] },
              { "text": "Pas maintenant",
                "next": "refus" }
            ]
          },
          "offre_marchandises": {
            "speaker": "Tom",
            "text": "Un chariot vide ne fait pas un marchand. Apporte-moi 16 blés et 8 pommes, et je reprends la route.",
            "choices": [
              { "text": "Commencer la quête : Des marchandises pour repartir",
                "conditions": [ { "type": "QUEST_STATE", "quest": "rpgquest:tom_marchandises", "state": "NOT_STARTED" } ],
                "actions": [ { "type": "START_QUEST", "quest": "rpgquest:tom_marchandises" }, { "type": "CLOSE" } ] },
              { "text": "Pas maintenant",
                "next": "refus" }
            ]
          },
          "refus": {
            "speaker": "Tom",
            "text": "Je comprends. Je serai là, à attendre ma chance.",
            "choices": [
              { "text": "À plus tard", "actions": [ { "type": "CLOSE" } ] }
            ]
          },
          "remise": {
            "speaker": "Tom",
            "text": "Voyons ce que tu m'apportes :<newline>%delivery_status%",
            "choices": [
              { "text": "Donner mes matériaux",
                "actions": [ { "type": "DELIVER_QUEST_ITEMS" } ],
                "next": "apres_remise" },
              { "text": "Plus tard", "actions": [ { "type": "CLOSE" } ] }
            ]
          },
          "apres_remise": {
            "speaker": "Tom",
            "text": "%delivery_status%",
            "choices": [
              { "text": "Donner encore",
                "conditions": [ { "type": "HAS_PENDING_DELIVERY" } ],
                "actions": [ { "type": "DELIVER_QUEST_ITEMS" } ],
                "next": "apres_remise" },
              { "text": "Retour", "next": "accueil" }
            ]
          },
          "conclusion": {
            "speaker": "Tom",
            "text": "Grâce à toi, mon chariot est chargé et je reprends la route. Si nos chemins se recroisent, je te ferai un bon prix !",
            "choices": [
              { "text": "Bonne route, Tom", "actions": [ { "type": "CLOSE" } ] }
            ]
          }
        }
      }
    ],
