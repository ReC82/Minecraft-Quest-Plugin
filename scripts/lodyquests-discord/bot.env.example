# LodyQuests — synchronisation forum Discord ↔ issues GitHub (issue #202)
#
# EXEMPLE. Le fichier réel vit HORS du dépôt, en
# ~/.config/lodyquests-discord/bot.env, en chmod 600, et n'est JAMAIS versionné.
#
#   install -d -m 700 ~/.config/lodyquests-discord
#   install -m 600 scripts/lodyquests-discord/bot.env.example \
#       ~/.config/lodyquests-discord/bot.env
#   # puis compléter les valeurs
#
# Après toute modification :
#   /opt/lodyquests-discord/app/bin/discord-sync check   # diagnostic, n'écrit rien
#   sudo systemctl restart lodyquests-discord

# --- Discord ---------------------------------------------------------------------------------

# Serveur surveillé. Mode développeur activé → clic droit sur le serveur → « Copier
# l'identifiant ». Uniquement des chiffres.
DISCORD_GUILD_ID=

# Salon de FORUM surveillé (type 15). Clic droit sur le salon → « Copier l'identifiant ».
# Un seul salon : le service ne regarde rien d'autre.
DISCORD_FORUM_CHANNEL_ID=

# Jeton du BOT Discord — portail développeurs → votre application → onglet « Bot » →
# « Reset Token ».
#
# ATTENTION, confusion fréquente et déjà rencontrée :
#   - ce n'est PAS le « Client Secret », ni la « Public Key », ni l'« Application ID » ;
#   - ce n'est PAS le jeton GitHub. Un jeton de bot Discord est fait de TROIS parties séparées
#     par des points ; un jeton GitHub commence par « ghp_ » ou « github_pat_ ».
# Le service vérifie la forme des deux jetons au démarrage et refuse de partir en disant
# lequel est mal placé, plutôt que de laisser un « 401 Unauthorized » inexploitable.
DISCORD_BOT_TOKEN=

# --- GitHub ----------------------------------------------------------------------------------

# Dépôt cible, au format propriétaire/dépôt.
GITHUB_REPOSITORY=ReC82/Minecraft-Quest-Plugin

# Jeton GitHub à permissions FINES, limité à ce seul dépôt, avec « Issues : Read and write ».
# Rien d'autre n'est nécessaire : le service ne touche ni au code, ni aux branches, ni aux
# workflows.
GITHUB_TOKEN=

# --- Facultatif ------------------------------------------------------------------------------

# Base d'état SQLite. Par défaut /var/lib/lodyquests-discord/sync.db.
#LODYQUESTS_SYNC_DB=/var/lib/lodyquests-discord/sync.db

# Intervalle de scrutation, en secondes (défaut 60, plancher 15).
#LODYQUESTS_POLL_SECONDS=60

# true = le service journalise ce qu'il FERAIT, sans écrire ni sur GitHub ni sur Discord.
# Utile pour une première mise en route observée.
#LODYQUESTS_DRY_RUN=false
