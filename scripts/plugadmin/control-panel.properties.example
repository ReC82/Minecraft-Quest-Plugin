# PlugAdmin — configuration NON SECRÈTE déployée sur AWS (issue #44)
#
# Installé par scripts/plugadmin/install.sh en
#   /etc/plugadmin/control-panel.properties  (root:plugadmin, chmod 644).
#
# Les secrets ne sont JAMAIS ici : voir /etc/plugadmin/plugadmin.env.
# Rappel de précédence : variables d'environnement > ce fichier > défauts du code.
# plugadmin.env fixe déjà port / base-url / cookie-secure / db / config ; ce
# fichier sert de référence lisible et de source pour la config des cibles.

panel.port=8090
panel.bind=127.0.0.1
panel.base-url=https://plugadmin.lodylands.com
panel.cookie-secure=true
panel.session-ttl-minutes=120
panel.session-idle-minutes=30
panel.owner-username=owner
panel.disabled=false
panel.db=/var/lib/plugadmin/control-panel.db

# --- Cibles RPGQuest (multi-environnement, prêt pour staging/prod plus tard) ---
targets=dev
targets.default=dev
target.dev.label=RPGQuest DEV
target.dev.mode=bridge
target.dev.bridge-url=http://127.0.0.1:8100/admin/v1
target.dev.token-env=RPGQUEST_BRIDGE_TOKEN_DEV
# Agent sortant associé à cette cible : le dashboard affiche en priorité l'état
# reçu de cet agent (mode AGENT DISTANT). Le bridge local reste un affichage
# secondaire.
target.dev.agent=rpgquest-dev

# --- Agents sortants — issue #51 -------------------------------------------
# RPGQuest / VeryGames initie une connexion HTTPS SORTANTE vers PlugAdmin ;
# PlugAdmin n'ouvre JAMAIS de connexion vers VeryGames (NAT/pare-feu).
agents=rpgquest-dev
agent.rpgquest-dev.environment=dev
# Variable d'environnement (dans /etc/plugadmin/plugadmin.env) contenant le
# jeton dédié de cet agent. Défaut si omis : RPGQUEST_AGENT_TOKEN_RPGQUEST_DEV.
agent.rpgquest-dev.token-env=RPGQUEST_AGENT_TOKEN_RPGQUEST_DEV
# Seuils de fraîcheur (secondes) : ONLINE <= stale < STALE <= offline < OFFLINE.
agent.stale-seconds=45
agent.offline-seconds=150
# Au-delà de ce délai sans résultat, une action passe EXPIRED (secondes).
agent.action-expiry-seconds=300

# --- Exploitation serveur — issue #95 ---------------------------------------
# Accès RCON de la cible, utilisé UNIQUEMENT par le redémarrage piloté depuis
# la page /ops. Trois commandes au total sont émissibles (list, save-all, stop) :
# c'est une énumération fermée côté code, pas une console.
#
# Sans ces clés, la fonction « redémarrer » s'affiche INDISPONIBLE avec son
# motif, et le reste de la page (état, annonce, console) fonctionne normalement.
# ops.rcon.dev.host=
# ops.rcon.dev.port=25575
# Nom de la variable d'environnement contenant le mot de passe RCON.
# Défaut si omis : RPGQUEST_RCON_PASSWORD_DEV. Le mot de passe n'est JAMAIS ici.
# ops.rcon.dev.password-env=RPGQUEST_RCON_PASSWORD_DEV
#
# Délais du redémarrage. Au-delà de return-timeout-seconds sans retour constaté,
# l'opération finit en ÉCHEC — jamais en « redémarré » optimiste.
ops.restart.return-timeout-seconds=240
ops.restart.poll-seconds=5
ops.restart.stop-grace-seconds=45
ops.rcon.timeout-seconds=10
# Intervalle minimal entre deux annonces automatiques (compte à rebours).
ops.announce.min-interval-seconds=10
# Lignes de console demandées à l'agent par consultation (1 à 500).
ops.logs.tail-lines=200
