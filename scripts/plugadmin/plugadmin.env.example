# ---------------------------------------------------------------------------
# PlugAdmin — EnvironmentFile du service systemd (EXEMPLE, sans secret)
# ---------------------------------------------------------------------------
#
# Ce .example est versionné et NE CONTIENT AUCUN secret.
#
# Le fichier RÉEL est créé HORS du dépôt Git, sur l'instance AWS, à :
#
#     /etc/plugadmin/plugadmin.env
#
# Permissions : root:plugadmin, chmod 640 (non lisible par « autres »).
# Format systemd EnvironmentFile : CLE=valeur, une par ligne, PAS de `export`,
# PAS de guillemets sauf nécessité. Lu par plugadmin.service.
#
# install.sh crée un squelette de ce fichier avec :
#   - RPGQUEST_PANEL_SECRET  généré aléatoirement (48 octets base64) ;
#   - RPGQUEST_BRIDGE_TOKEN_DEV  généré aléatoirement (dormant jusqu'à #51) ;
#   - RPGQUEST_PANEL_OWNER_HASH  laissé À COMPLÉTER (voir ci-dessous).
# ---------------------------------------------------------------------------

# --- OBLIGATOIRE : secret de signature du cookie de session (>= 32 car.) -----
# Généré par install.sh. Le régénérer invalide toutes les sessions ouvertes.
RPGQUEST_PANEL_SECRET=REMPLACER_PAR_48_OCTETS_BASE64_ALEATOIRES

# --- OBLIGATOIRE : hash du mot de passe owner --------------------------------
# JAMAIS le mot de passe en clair. Générer le hash avec :
#     sudo -u plugadmin /opt/plugadmin/app/bin/control-panel hash-password
# puis coller la valeur « pbkdf2_sha256$... » ici et `systemctl restart plugadmin`.
RPGQUEST_PANEL_OWNER_HASH=pbkdf2_sha256$210000$REMPLACER

# --- Réseau / cookies (HTTPS derrière nginx) --------------------------------
RPGQUEST_PANEL_PORT=8090
RPGQUEST_PANEL_COOKIE_SECURE=true
RPGQUEST_PANEL_BASE_URL=https://plugadmin.lodylands.com

# --- Emplacements hors dépôt ----------------------------------------------
RPGQUEST_PANEL_CONFIG=/etc/plugadmin/control-panel.properties
RPGQUEST_PANEL_DB=/var/lib/plugadmin/control-panel.db

# --- Cible RPGQuest DEV — bridge local #37 (optionnel) --------------------
# Dormant sur AWS : aucun bridge n'écoute sur 127.0.0.1:8100 (RPGQuest tourne
# chez VeryGames). Utile seulement pour un RPGQuest co-localisé / du dev local.
RPGQUEST_BRIDGE_TOKEN_DEV=REMPLACER_PAR_TOKEN_ALEATOIRE

# --- Agent sortant DEV — issue #51 (OBLIGATOIRE pour l'état live) ---------
# Jeton PARTAGÉ avec plugins/RPGQuest/plugadmin-agent.properties côté serveur
# RPGQuest (clé "token="). C'est ce canal (HTTPS entrant sur PlugAdmin, initié
# par VeryGames) qui fait passer le dashboard en « ONLINE ». Nom de variable
# dérivé de l'id d'agent : RPGQUEST_AGENT_TOKEN_<AGENT_ID en MAJUSCULES, '-'->'_'>.
RPGQUEST_AGENT_TOKEN_RPGQUEST_DEV=REMPLACER_PAR_LE_MEME_JETON_QUE_L_AGENT

# --- Kill-switch (décommenter pour couper l'accès sans redéployer) ---------
# Coupe aussi l'ingestion des heartbeats agent (503) -> l'agent passe OFFLINE.
# PANEL_DISABLED=true
