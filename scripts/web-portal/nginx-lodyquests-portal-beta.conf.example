# Bêta restreinte du portail LodyQuests (#421, décision du propriétaire du 24/10/2026).
#
# Copié tel quel en /etc/nginx/snippets/lodyquests-portal-beta.conf, il est inclus par le vhost
# (include /etc/nginx/snippets/lodyquests-portal-beta*.conf) : tout le site demande alors un accès
# bêta, sauf /health, /demo/ et les routes machine /api/snapshot et /api/link/*.
#
# Les comptes vivent dans /etc/nginx/lodyquests-portal-beta.htpasswd (hors Git, root:www-data 640),
# créés avec : openssl passwd -apr1 → ligne « identifiant:empreinte ». Aucun mot de passe ici.
#
# Ouvrir le portail à tous : supprimer /etc/nginx/snippets/lodyquests-portal-beta.conf,
# sudo nginx -t && sudo systemctl reload nginx.
auth_basic "LodyQuests - beta";
auth_basic_user_file /etc/nginx/lodyquests-portal-beta.htpasswd;
