# ---------------------------------------------------------------------------
# Portail public LodyQuests — EnvironmentFile du service (EXEMPLE, sans secret)
# ---------------------------------------------------------------------------
# Le fichier RÉEL vit HORS du dépôt : /etc/lodyquests-portal/portal.env
# (root:lodyquests-web, chmod 640). install.sh le crée VIDE de secret ; rien n'y est obligatoire.
#
# Jeton de l'API /api/* (outils authentifiés uniquement). ABSENT par défaut : toutes les requêtes
# /api/* répondent 401, et nginx renvoie de toute façon 404 sur /api/ côté public.
# Ne jamais réutiliser un secret de PlugAdmin ici.
# RPGQUEST_WEB_API_TOKEN=REMPLACER_PAR_UN_JETON_ALEATOIRE

# Comptes joueurs (#53) : jeton DÉDIÉ à POST /api/link/confirm, que le serveur Minecraft présente
# après « /lien <code> ». Le même jeton va dans plugins/RPGQuest/portal-link.properties côté
# VeryGames (hors Git). Il n'ouvre que cette route ; ne jamais réutiliser RPGQUEST_WEB_API_TOKEN ni
# un secret de PlugAdmin. Générer : openssl rand -base64 36
# RPGQUEST_PORTAL_LINK_TOKEN=REMPLACER_PAR_UN_JETON_ALEATOIRE

# Instantané du serveur Minecraft (#421) : jeton DÉDIÉ à POST /api/snapshot, que le plugin présente
# à chaque export. Le même jeton va dans plugins/RPGQuest/portal-snapshot.properties côté VeryGames
# (hors Git). Absent : la route refuse tout (401) et le portail affiche « état inconnu ». Ne jamais
# réutiliser un autre jeton. Générer : openssl rand -base64 36
# RPGQUEST_PORTAL_SNAPSHOT_TOKEN=REMPLACER_PAR_UN_JETON_ALEATOIRE
